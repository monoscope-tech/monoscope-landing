{% render "default/components/head", this:this, config:config %}
{% render "default/components/nav", this:this, config:config %}
{% render "default/components/changelog-style" %}

<main id="main" class="pb-24 md:pb-32">
  <section class="tone-brand relative w-full">
    <div aria-hidden="true" class="absolute top-(--inset) bottom-0 left-1/2 -translate-x-1/2 panel-w rounded-[2rem] overflow-hidden bg-(--tone-panel) border border-(--tone-weak)">
      {% capture art_classes %}absolute inset-x-0 bottom-0 w-full h-44 md:h-64 object-cover object-left-bottom [mask-image:linear-gradient(to_top,black_30%,rgb(0_0_0/.8)_44%,rgb(0_0_0/.52)_58%,rgb(0_0_0/.26)_72%,rgb(0_0_0/.09)_86%,transparent)]{% endcapture %}{% render "default/components/section-art", art:"page-changelog.webp", classes:art_classes, width:2688, height:448 %}
    </div>
    <div class="relative wrap max-w-[80rem] pt-32 md:pt-44 pb-48 md:pb-72">
      <div class="space-y-6 max-w-3xl [&>p:first-child]:mb-3.5">
        <p class="inline-flex rounded-md px-2.5 py-1 eyebrow font-mono text-[12px] uppercase tracking-wider bg-(--tone-weak)">Changelog</p>
        <h1 class="text-4xl md:text-[42px] font-medium tracking-tight leading-[1.2] text-balance text-textStrong">What we shipped, month by month</h1>
        <p class="max-w-[65ch] text-[17.5px] leading-[1.65] text-textWeak text-pretty">New features, fixes and speedups in monoscope, written for the people who use it. Every entry links to the details.</p>
      </div>
    </div>
  </section>

  {% assign entries = file_list | where_glob: 'file_path', "./changelog/*/index.md" | sort: "frontmatter.date" | reverse %}
  <div class="wrap max-w-[64rem] mt-20 md:mt-28">
    {% assign last_year = "" %}
    <ol class="relative">
      <span aria-hidden="true" class="absolute start-[5px] md:start-[calc(9rem+5px)] top-3 bottom-3 w-0.5 bg-strokeWeak"></span>
      {% for entry in entries %}
        {% assign fm = entry.frontmatter %}
        {% assign year = fm.date | date: "%Y" %}
        {% if year != last_year %}
          <li class="ps-8 md:ps-[11rem] {% unless forloop.first %}pt-4 md:pt-8{% endunless %} pb-10">
            <div class="relative">
              <span aria-hidden="true" class="absolute -start-8 top-[calc(50%-6px)] size-3 rounded-full bg-textStrong"></span>
              <h2 class="text-[28px] md:text-[32px] font-medium tracking-tight leading-none text-textStrong tabular-nums">{{ year }}</h2>
            </div>
          </li>
          {% assign last_year = year %}
        {% endif %}
        {% if fm.weekEnd %}{% assign when = fm.date | date: "%b %-d" %}{% assign when_cls = "block" %}{% else %}{% assign when = fm.date | date: "%B" %}{% assign when_cls = "sr-only" %}{% endif %}
        <li class="relative ps-8 md:ps-[11rem] pb-14 md:pb-16">
          <span aria-hidden="true" class="absolute start-0 md:start-[9rem] top-[7px] size-3 rounded-full border-2 border-textBrand bg-bgBase"></span>
          <time datetime="{{ fm.date }}" class="md:absolute md:start-0 md:top-0.5 md:w-32 {{ when_cls }} font-mono text-[12px] uppercase tracking-wider text-textWeak">{{ when }}</time>
          <article class="mt-2 md:mt-0 space-y-4">
            <h3 class="text-[22px] md:text-2xl font-medium tracking-tight leading-[1.3] text-balance text-textStrong">
              <a href="{{ entry.permalink }}" class="hover:text-textBrand transition-colors duration-150">{{ fm.title }}</a>
            </h3>
            {% if fm.summary %}<p class="max-w-[65ch] text-[17.5px] leading-[1.6] text-textWeak text-pretty">{{ fm.summary }}</p>{% endif %}
            {% render "default/components/changelog-tags", fm: fm, max: 4 %}
            {% if fm.highlights %}
              <ul class="card mt-6 rounded-2xl border border-strokeWeak divide-y divide-strokeWeak overflow-hidden">
                {% for h in fm.highlights %}
                  <li class="flex gap-3 px-5 py-4 text-[15px] leading-relaxed text-textStrong text-pretty">
                    <svg class="mt-[5px] size-4 shrink-0 text-textBrand" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7"/></svg>
                    <span>{{ h }}</span>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
            <a href="{{ entry.permalink }}" class="inline-flex items-center gap-1.5 pt-1 text-[15px] font-medium text-textBrand underline underline-offset-4 decoration-1 hover:decoration-2">Read the full update<span class="sr-only"> for {{ fm.title }}</span><span aria-hidden="true">→</span></a>
          </article>
        </li>
      {% endfor %}
    </ol>
  </div>
</main>

{% render "default/components/foot", this:this, config:config %}
