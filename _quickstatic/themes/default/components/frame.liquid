{% comment %}Product frame: a <demo-scene> storyboard (always dark) or a screenshot pair /assets/img/product/<shot>-{light,dark}.webp. Params: demo | shot, label, alt, eager{% endcomment %}
<div {% if demo %}data-theme="dark" {% endif %}class="relative rounded-xl border border-strokeWeak bg-bgRaised{% if demo %}!{% endif %} overflow-hidden shadow-[0_24px_64px_-32px_var(--tone-fill)]">
  <div class="flex items-center gap-1.5 px-4 h-[31px] border-b border-strokeWeak"><i class="block size-2.5 rounded-full bg-strokeWeak"></i><i class="block size-2.5 rounded-full bg-strokeWeak"></i><i class="block size-2.5 rounded-full bg-strokeWeak"></i>{% if label %}<span class="ms-3 truncate font-mono text-[12px] text-textWeak">{{label}}</span>{% endif %}</div>
  {% if demo %}<div class="relative bg-fillWeak" style="aspect-ratio: 1180 / 820;"><demo-scene src="{{demo}}" class="absolute inset-0"></demo-scene></div>
  {% else %}<img src="/assets/img/product/{{shot}}-light.webp" alt="{{alt}}" width="2880" height="1800" {% unless eager %}loading="lazy" {% endunless %}class="block w-full h-auto dark:hidden"><img src="/assets/img/product/{{shot}}-dark.webp" alt="{{alt}}" width="2880" height="1800" {% unless eager %}loading="lazy" {% endunless %}class="hidden w-full h-auto dark:block">{% endif %}
</div>
