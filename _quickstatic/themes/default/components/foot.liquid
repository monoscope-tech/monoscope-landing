<script>
  // highlight.js is fetched only on pages with code blocks; its core bundle already covers go/js/php/csharp/python.
  function highlightCode() {
    if (!document.querySelector('pre code')) return;
    if (window.hljs) return hljs.highlightAll();
    if (window.hljsLoading) return;
    window.hljsLoading = true;
    const base = 'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/';
    const load = src => new Promise(onload => document.head.appendChild(Object.assign(document.createElement('script'), { src: base + src, onload })));
    document.head.appendChild(Object.assign(document.createElement('link'), { rel: 'stylesheet', href: base + 'styles/atom-one-dark.min.css' }));
    load('highlight.min.js').then(() => load('languages/elixir.min.js')).then(() => hljs.highlightAll());
  }
</script>
<script defer type="text/javascript">
  function loadConvertKitForm(uid) {
      // Check if the script is already loaded
      const existingScript = document.querySelector('script[data-uid="'+uid+'"]');
      if (existingScript) {
          // Optionally, remove the existing script and re-add it to re-initialize the form
          existingScript.remove();
      }

      var elements = document.getElementsByClassName(uid);
      for (var i = 0; i < elements.length; i++) {
        // Create a new script element for the ConvertKit form
        var script = document.createElement('script');
        script.dataset.uid = uid; // Your form's unique ID
        script.src = "https://monoscope.kit.com/"+uid+"/index.js"; // The script source
        elements[i].replaceChildren(script);
      }
  }

