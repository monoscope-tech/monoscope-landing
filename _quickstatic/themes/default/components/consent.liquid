      dispatchEvent(new CustomEvent('ms:consent', { detail: v }));
    };

    const show = focus => {
      if (document.getElementById('ms-consent')) return;
      const el = document.getElementById('ms-consent-tpl').content.firstElementChild.cloneNode(true), opener = document.activeElement;
      const close = () => { el.remove(); focus && opener?.focus?.(); };
      el.addEventListener('click', e => { const b = e.target.closest('[data-choice]'); if (b) { c.set(b.dataset.choice); close(); } });
      el.addEventListener('keydown', e => e.key == 'Escape' && c.saved && close());
      document.body.append(el);
      focus && el.querySelector('[data-choice="granted"]').focus();
    };
    c.open = () => show(true);
    document.addEventListener('click', e => { if (e.target.closest?.('[data-cookie-settings]')) { e.preventDefault(); show(true); } });
    if (!saved && eea) document.readyState == 'loading' ? addEventListener('DOMContentLoaded', () => show()) : show();
  })();
</script>
