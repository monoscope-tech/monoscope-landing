<script>
  // Consent Mode v2 defaults, set before GTM or any Google tag reads the dataLayer, plus the idle loader for third-party tags.
  // EEA/UK/CH is detected from the browser's IANA time zone: a static page never sees Cloudflare's CF-IPCountry header.
  // Europe/* over-includes (Moscow, Istanbul), the island zones cover Iceland, Canaries, Madeira, Azores, Faroe, Svalbard
  // and Cyprus, and an unreadable zone counts as EEA.
  window.msConsent || (() => {
    const dl = window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () { dl.push(arguments); };
    let tz = '';
    try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch {}
    const eea = !tz || /^(Europe|Arctic)\/|^Atlantic\/(Reykjavik|Canary|Madeira|Azores|Faroe)|^Asia\/(Nicosia|Famagusta)/.test(tz);
    const host = location.hostname, domain = /\.[a-z]+$/i.test(host) ? '; Domain=.' + host.split('.').slice(-2).join('.') : '';
    const cookie = (n, v, maxAge) => document.cookie = `${n}=${encodeURIComponent(v)}; Max-Age=${maxAge}; Path=/; SameSite=Lax${domain}${location.protocol == 'https:' ? '; Secure' : ''}`;
    const saved = (document.cookie.match(/(?:^|; )ms_consent=(granted|denied)/) || [])[1];
    const modes = v => ({ ad_storage: v, ad_user_data: v, ad_personalization: v, analytics_storage: v });
    const c = window.msConsent = { eea, saved, granted: saved ? saved == 'granted' : !eea, idle: false, cookie };
    gtag('consent', 'default', { ...modes(c.granted ? 'granted' : 'denied'), wait_for_update: 500 });
    gtag('set', 'ads_data_redaction', true);
    // The GTM containers also hold LinkedIn, Reddit and Apollo tags that ignore consent mode. GTM reads its blocklist once,
    // so without consent they stay off for this page view; the next page after Accept loads them.
    c.granted || dl.push({ 'gtm.blocklist': ['customScripts', 'nonGoogleScripts', 'nonGooglePixels', 'nonGoogleIframes'] });

    // Third-party tags are inert text/plain until the page is idle after load, so they never compete with first paint,
    // the demos or the first scroll; data-consent ones also wait for consent
    const run = sel => document.querySelectorAll(sel).forEach(o => {
      const s = document.createElement('script');
      for (const a of o.attributes) if (!['type', 'data-later', 'data-consent'].includes(a.name)) s.setAttribute(a.name, a.value);
      s.text = o.text; o.replaceWith(s);
