    addEventListener('load', () => setTimeout(() => (window.requestIdleCallback || setTimeout)(() => {
      run(c.granted ? 'script[data-later]' : 'script[data-later]:not([data-consent])');
      c.idle = true; dispatchEvent(new Event('ms:idle'));
    }, { timeout: 3000 }), 1500));

    c.set = v => {
      const was = c.granted;
      c.saved = v; c.granted = v == 'granted';
      cookie('ms_consent', v, 31536000);
      gtag('consent', 'update', modes(v));
      dl.push({ event: 'consent_update', consent: v });
