{% comment %}GitHub Conversation UI for production-impact comments. Keep reviews advisory; code snippets use the chapter code renderer.{% endcomment %}
<div class="relative overflow-hidden rounded-xl ring-1 ring-white/10 bg-[#0D1117] text-[#F0F6FC] shadow-[0_24px_64px_-32px_var(--tone-fill)] [font-family:-apple-system,BlinkMacSystemFont,'Segoe_UI','Noto_Sans',Helvetica,Arial,sans-serif] [&_.m]:text-[#9198A1] [&_.b]:border-[#3D444D] [&_code]:font-mono [&_code]:text-[85%] [&_code]:rounded-md [&_code]:bg-[#656C7633] [&_code]:px-[0.4em] [&_code]:py-[0.2em]" data-theme="dark" data-github-review role="img" aria-label="GitHub pull request #{{review.number}} in {{review.repository}}: monoscope comments with an advisory production impact review, {{review.verdict}}, based on {{review.events}} production events and {{review.errors}} errors. Reviews do not block merging.">
            <div class="flex items-center gap-3 px-4 py-2.5 border-b b bg-[#010409]"><span class="flex gap-1.5"><i class="block size-3 rounded-full bg-[#FF5F57]"></i><i class="block size-3 rounded-full bg-[#FEBC2E]"></i><i class="block size-3 rounded-full bg-[#28C840]"></i></span><span class="flex-1 rounded-md bg-[#151B23] px-3 py-1 text-center text-[12px] m">github.com/{{review.repository}}/pull/{{review.number}}</span></div>
            <div aria-hidden="true" class="px-5 md:px-6 pt-5 pb-6 text-[14px] leading-[1.5]">
              <p class="text-[24px] md:text-[28px] font-normal leading-tight">{{review.title}} <span class="m font-light">#{{review.number}}</span></p>
              <p class="mt-2 flex flex-wrap items-center gap-2 m"><span class="inline-flex items-center gap-1 rounded-full bg-[#238636] px-3 py-[5px] text-sm font-medium text-white"><svg class="size-4" viewBox="0 0 16 16" fill="currentColor"><path d="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25Zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354ZM3.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm0 9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm8.25.75a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Z"/></svg>Open</span><span><b class="text-[#F0F6FC] font-semibold">{{review.author}}</b> wants to merge 3 commits into <span class="rounded-md bg-[#388BFD26] px-1.5 py-0.5 font-mono text-[12px] text-[#4493F8]">main</span> from <span class="rounded-md bg-[#388BFD26] px-1.5 py-0.5 font-mono text-[12px] text-[#4493F8]">{{review.branch}}</span></span></p>
              <div class="mt-4 flex gap-1 overflow-x-auto border-b b text-sm"><span class="shrink-0 -mb-px border-b-2 border-[#F78166] font-semibold text-[#F0F6FC] inline-flex items-center gap-2 px-2 pb-2.5"><svg class="size-4 shrink-0 text-[#9198A1]" viewBox="0 0 16 16" fill="currentColor"><path d="M1.75 1h8.5c.966 0 1.75.784 1.75 1.75v5.5A1.75 1.75 0 0 1 10.25 10H7.061l-2.574 2.573A1.458 1.458 0 0 1 2 11.543V10h-.25A1.75 1.75 0 0 1 0 8.25v-5.5C0 1.784.784 1 1.75 1Z"/></svg>Conversation<span class="rounded-full bg-[#656C7633] px-1.5 text-[12px] leading-[18px] text-[#F0F6FC]">1</span></span><span class="shrink-0 m border-b-2 border-transparent inline-flex items-center gap-2 px-2 pb-2.5"><svg class="size-4 shrink-0 text-[#9198A1]" viewBox="0 0 16 16" fill="currentColor"><path d="M11.93 8.5a4.002 4.002 0 0 1-7.86 0H.75a.75.75 0 0 1 0-1.5h3.32a4.002 4.002 0 0 1 7.86 0h3.32a.75.75 0 0 1 0 1.5Zm-1.43-.75a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0Z"/></svg>Commits<span class="rounded-full bg-[#656C7633] px-1.5 text-[12px] leading-[18px] text-[#F0F6FC]">3</span></span><span class="shrink-0 m border-b-2 border-transparent inline-flex items-center gap-2 px-2 pb-2.5"><svg class="size-4 shrink-0 text-[#9198A1]" viewBox="0 0 16 16" fill="currentColor"><path d="M2.5 1.75v11.5c0 .138.112.25.25.25h3.17a.75.75 0 0 1 0 1.5H2.75A1.75 1.75 0 0 1 1 13.25V1.75C1 .784 1.784 0 2.75 0h8.5C12.216 0 13 .784 13 1.75v7.736a.75.75 0 0 1-1.5 0V1.75a.25.25 0 0 0-.25-.25h-8.5a.25.25 0 0 0-.25.25Zm13.274 9.537v-.001l-4.557 4.45a.75.75 0 0 1-1.055-.008l-1.943-1.95a.75.75 0 0 1 1.062-1.058l1.419 1.425 4.026-3.932a.75.75 0 1 1 1.048 1.074ZM4.75 4h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1 0-1.5Z"/></svg>Checks<span class="rounded-full bg-[#656C7633] px-1.5 text-[12px] leading-[18px] text-[#F0F6FC]">4</span></span><span class="shrink-0 m border-b-2 border-transparent inline-flex items-center gap-2 px-2 pb-2.5"><svg class="size-4 shrink-0 text-[#9198A1]" viewBox="0 0 16 16" fill="currentColor"><path d="M1 1.75C1 .784 1.784 0 2.75 0h7.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16H2.75A1.75 1.75 0 0 1 1 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25V4.664a.25.25 0 0 0-.073-.177l-2.914-2.914a.25.25 0 0 0-.177-.073ZM8 3.25a.75.75 0 0 1 .75.75v1.5h1.5a.75.75 0 0 1 0 1.5h-1.5v1.5a.75.75 0 0 1-1.5 0V7h-1.5a.75.75 0 0 1 0-1.5h1.5V4A.75.75 0 0 1 8 3.25Zm-3 8a.75.75 0 0 1 .75-.75h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1-.75-.75Z"/></svg>Files changed<span class="rounded-full bg-[#656C7633] px-1.5 text-[12px] leading-[18px] text-[#F0F6FC]">1</span></span></div>

      <div class="relative mt-5 ps-0 sm:ps-14">
        <div class="relative flex">
          <span class="absolute -start-14 top-0 hidden sm:grid size-10 place-items-center rounded-full bg-[#0068FF] font-mono text-[12px] font-bold text-white">[·]</span>
          <div class="relative flex-1 min-w-0 rounded-md border b bg-[#0D1117]">
            <div class="flex items-center gap-2 rounded-t-md border-b b bg-[#151B23] px-4 py-2 m">
              <b class="text-[#F0F6FC] font-semibold">monoscope</b><span class="rounded-full border b px-1.5 text-[12px]">bot</span><span>commented just now</span><span class="ms-auto hidden sm:inline">···</span>
            </div>
            <div class="px-4 py-4 space-y-4">
              <div class="flex flex-wrap items-center gap-2"><h3 class="text-lg font-semibold">Monoscope production impact</h3><span class="rounded-full border border-[#D2992266] bg-[#D299221A] px-2 py-0.5 text-[12px] font-medium text-[#E3B341]">{{review.verdict}}</span></div>
              <p class="m">Project <b class="text-[#F0F6FC]">{{review.project}}</b> · reviewed <code>{{review.commit}}</code> · advisory</p>
              <p class="text-[12px] m">Evidence window (UTC): {{review.window}}</p>
              <div class="rounded-md border b overflow-hidden">
                <p class="border-b b bg-[#151B23] px-3 py-2 break-all"><span class="font-mono text-[12px] text-[#4493F8]">{{review.file}}</span> <span class="text-[12px] m">(Head)</span></p>
                <div class="px-3 py-3 space-y-3">
                  <table class="w-full text-start text-[14px] border-collapse"><tbody><tr class="border-b b"><th class="py-2 pe-4 text-start font-medium m">Production events</th><td class="py-2 text-end tabular-nums">{{review.events}}</td></tr><tr><th class="py-2 pe-4 text-start font-medium m">Errors on this path</th><td class="py-2 text-end tabular-nums">{{review.errors}}</td></tr></tbody></table>
                  <p><b>Inferred:</b> {{review.finding}}</p>
                  <p><b>Next check:</b> {{review.next_check}}</p>
                </div>
              </div>
              <p class="text-[12px] m">Advisory review · does not block merging.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
